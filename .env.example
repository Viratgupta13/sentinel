# Anthropic API key (required for triage + review LLM calls)
# Get one at https://platform.claude.com/
ANTHROPIC_API_KEY=

# GitHub token (optional - falls back to `gh auth token`, then unauthenticated)
GITHUB_TOKEN=

# --- Sentinel tuning (all optional, sane defaults in src/sentinel/config.py) ---
# Risk score (0-10) at or above which a hunk gets a deep Opus review
SENTINEL_RISK_THRESHOLD=4
# Hard cap on deep-reviewed hunks per PR (cost guard)
SENTINEL_MAX_REVIEW_HUNKS=12
# Model overrides
SENTINEL_TRIAGE_MODEL=claude-haiku-5-5
SENTINEL_REVIEW_MODEL=claude-opus-5-5

# --- Free-tier testing via any OpenAI-compatible endpoint ---
# Uncomment ONE block. Prompt caching + effort control are Anthropic-only, so
# the cost ledger shows raw token counts (priced $0 for unknown models).
#
# Groq (console.groq.com - free tier):
# SENTINEL_PROVIDER=openai
# SENTINEL_OPENAI_BASE_URL=https://api.groq.com/openai/v1
# SENTINEL_OPENAI_API_KEY=gsk_...
# SENTINEL_TRIAGE_MODEL=openai/gpt-oss-20b
# SENTINEL_REVIEW_MODEL=openai/gpt-oss-120b
# SENTINEL_EXTRACTION_MODEL=openai/gpt-oss-120b
#
# Google AI Studio (aistudio.google.com - free tier):
# SENTINEL_PROVIDER=openai
# SENTINEL_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# SENTINEL_OPENAI_API_KEY=AIza...
# SENTINEL_TRIAGE_MODEL=gemini-2.5-flash-lite
# SENTINEL_REVIEW_MODEL=gemini-2.5-flash
# SENTINEL_EXTRACTION_MODEL=gemini-2.5-flash

# --- Phase 5: webhook server (sentinel serve) ---
# Secret configured on the GitHub webhook; required in prod (HMAC verification).
# SENTINEL_WEBHOOK_SECRET=
# Set to false to skip posting the review comment back to the PR.
# SENTINEL_POST_COMMENTS=true
